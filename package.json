{
  "name": "dsh-codex-link",
  "version": "0.2.0",
  "private": true,
  "description": "DeepSeek Harness plugin: the ChatGPT sign-in the harness is missing, plus a Codex quota card.",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg"
  },
  "files": [
    "index.js",
    "client",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "assets",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "contract": "node scripts/check-contract.mjs",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.build.json && node scripts/check-contract.mjs && node --test test/*.test.js",
    "read": "node lib/cli.js"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "codex"
  ],
  "license": "MIT"
}
